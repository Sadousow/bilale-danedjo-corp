# ---------------------------------------------------------------------------
# Base de données PostgreSQL
# Exemples :
#   Neon      postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/bdcorp?sslmode=require
#   Local     postgresql://postgres:postgres@localhost:5432/bdcorp
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/bdcorp?sslmode=require"

# Connexion directe (sans pooler) — utilisée par les migrations Prisma.
# Sur Neon : la même URL sans "-pooler" dans le hostname.
# En local, mettre la même valeur que DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/bdcorp?sslmode=require"

# ---------------------------------------------------------------------------
# Sécurité des sessions
# Générer une valeur aléatoire de 32+ caractères :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET="changez-moi-par-une-chaine-aleatoire-de-32-caracteres-minimum"

# ---------------------------------------------------------------------------
# Multi-tenant
#
# Domaine racine de la plateforme. Chaque boutique vit sur un sous-domaine :
#   bilale.tondomaine.com
# En développement, `bilale.localhost:3000` fonctionne dans Chrome et Firefox ;
# `bilale.lvh.me:3000` marche partout.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ROOT_DOMAIN="tondomaine.com"

# Clé maître de chiffrement des secrets des marchands (clés Djomy).
# En changer rend illisibles tous les secrets déjà enregistrés.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TENANT_SECRET_KEY="changez-moi-32-caracteres-minimum"

# ---------------------------------------------------------------------------
# URL publique de la PLATEFORME.
#
# ⚠️ Ne sert qu'aux liens de paiement des abonnements des marchands.
# Les retours de paiement d'une BOUTIQUE utilisent l'hôte de la requête, donc
# le sous-domaine ou le domaine personnalisé du marchand : une valeur unique
# renverrait tous les clients au mauvais endroit après leur règlement.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://tondomaine.com"

# ---------------------------------------------------------------------------
# Sécurité — politique de sécurité du contenu (CSP)
#
# Mettre à 1 pour la première mise en ligne : la politique est annoncée au
# navigateur mais rien n'est bloqué, les infractions apparaissent seulement
# dans la console. Parcourir la vitrine, la caisse, le back-office et le
# paiement, puis repasser à vide (ou 0) pour activer le blocage.
# ---------------------------------------------------------------------------
CSP_REPORT_ONLY=""

# ---------------------------------------------------------------------------
# Stockage des images (logos, bannières, photos produits)
#
# Compatible S3. Recommandé : Cloudflare R2 — pas de frais de sortie.
#   1. Créer un bucket R2 et activer l'accès public (ou un domaine perso)
#   2. Créer un jeton API avec les droits lecture/écriture sur ce bucket
#
# Laisser vide désactive le téléversement : couleurs et textes restent
# modifiables, mais pas les images.
# ---------------------------------------------------------------------------
S3_ENDPOINT="https://<compte>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="boutiques"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Base publique du bucket — c'est cette URL qui apparaît dans les pages
S3_PUBLIC_URL="https://images.tondomaine.com"

# ---------------------------------------------------------------------------
# Envoi d'emails — Resend (https://resend.com)
#
# 1. Créer un compte, ajouter le domaine guygou.com
# 2. Poser les enregistrements DNS proposés (DKIM, SPF, et un DMARC)
# 3. Attendre la vérification, puis créer une clé d'API
#
# MAIL_FROM doit être sur le domaine vérifié. Le nom affiché est ajouté à
# l'envoi : c'est celui de la BOUTIQUE, pour qu'un client reconnaisse son
# commerçant dans sa boîte de réception.
#
# Laisser vide désactive l'envoi : l'application fonctionne, mais la
# récupération de mot de passe et les accusés de réception ne partent pas.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="notifications@guygou.com"
# Adresse de réponse de repli, quand la boutique n'en a pas renseigné
MAIL_REPLY_TO=""
# Prévenu à chaque nouvelle inscription de boutique. Laisser vide désactive
# l'alerte — mais un appel dans les 24 heures double les chances qu'une
# inscription devienne un client payant.
SIGNUP_ALERT_EMAIL=""

# ---------------------------------------------------------------------------
# Facturation des abonnements
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Paiement en ligne — Djomy (https://djomy.africa)
# Clés disponibles dans l'espace marchand → Développeurs.
# Laisser vide pour désactiver le paiement en ligne : les clients
# commanderont alors uniquement en paiement à la livraison.
#
# ⚠️ Ces clés sont celles de la PLATEFORME (abonnements des marchands).
# Chaque marchand enregistre les siennes dans son back-office : elles sont
# chiffrées en base et servent à encaisser ses propres commandes.
#
# Sandbox : https://sandbox.djomy.africa
# Webhook marchand à déclarer : https://<boutique>/api/paiement/djomy/<tenantId>
# ---------------------------------------------------------------------------
DJOMY_CLIENT_ID=""
DJOMY_CLIENT_SECRET=""
DJOMY_API_BASE_URL="https://api.djomy.africa"
DJOMY_COUNTRY_CODE="GN"
# Méthodes proposées sur la page de paiement (vide = toutes)
# OM, MOMO, SOUTRA_MONEY, PAYCARD, CARD
DJOMY_PAYMENT_METHODS=""

# ---------------------------------------------------------------------------
# Mots de passe créés par le script de seed (optionnel)
# ---------------------------------------------------------------------------
# SEED_ADMIN_PASSWORD="..."
# SEED_GERANT_PASSWORD="..."
# SEED_CAISSIER_PASSWORD="..."
